# Copy this file to .env and adjust values for your machine
# NOTE: this service has its OWN database (marketplace_orders),
# NOT the products database. DB per service.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/marketplace_orders?schema=public"

# Port this service listens on (the gateway forwards requests here)
PORT=3002

# RabbitMQ broker this service PUBLISHES events to
RABBITMQ_URL="amqp://guest:guest@localhost:5672"
